# Copy to .env and fill in your own values. .env is excluded from Git.
# Add SMTP_FROM to your Amazon Approved Personal Document Email List.
# One address, or comma-separated addresses: alice@kindle.com,bob@kindle.com
# With multiple addresses, select --to 1,2 or --all-recipients when sending.
KINDLE_EMAIL=
SMTP_HOST=
SMTP_PORT=587
# starttls (usually 587) or ssl (usually 465). TLS is always required.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=30
# Conservative limit on the complete encoded email; adjust for your provider.
SMTP_MAX_MESSAGE_MB=20
EMAIL_SUBJECT=einkrelayer documents
# Optional digest branding; blank uses einkrelayer Digest.
DIGEST_TITLE=einkrelayer Digest

# Digest relay: the shared mailbox that receives submitted links (IMAP over TLS).
# Public receiving address; send to readings+<user>@example.org.
RELAY_ADDRESS=readings@example.org
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
# Optional: IMAP_FOLDER=INBOX, RELAY_USERS_FILE=users.toml, RELAY_STATE_DIR=state
